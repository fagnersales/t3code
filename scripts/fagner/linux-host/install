#!/bin/bash
# Make a fork build the T3 this PC opens: put it beside the Nightly (lib.sh says where), point the
# launcher and the t3 CLI at it, relaunch. The Nightly stays installed.
#
#   install --quit             quit the running T3 (refuses while a thread is busy), swap, relaunch
#   install                    only if T3 is not running
#   options: --version V (default: the latest build)  --force (quit even with busy threads)
#            --no-relaunch  --foreground (stay attached; used by the detached copy)
#
# Never touches ~/.t3/userdata. The fork adds no migrations of its own, but a build on a newer
# Nightly brings that Nightly's: once it runs, older builds cannot open the data.
set -euo pipefail
source "$(dirname "$0")/lib.sh"

quit=0 relaunch=1 foreground=0 force=0 version=""
args=("$@")
while [ $# -gt 0 ]; do
  case "$1" in
    --quit) quit=1 ;;
    --no-relaunch) relaunch=0 ;;
    --foreground) foreground=1 ;;
    --force) force=1 ;;
    --version) version="$2"; shift ;;
    -h | --help) sed -n '2,11p' "$0"; exit 0 ;;
    *) die "Unknown option $1" ;;
  esac
  shift
done

[ -n "$version" ] || version="$(readlink "$FAGNER_LINUX_BUILDS/latest" || true)"
[ -n "$version" ] || die "No build in $FAGNER_LINUX_BUILDS. Run scripts/fagner/linux build first."
build="$FAGNER_LINUX_BUILDS/$version/app"
[ -d "$build" ] || die "No build at $build."
[ "$(app_version "$build")" = "$version" ] || die "$build is version '$(app_version "$build")', not $version."
case "$version" in *-fagner.*) ;; *) die "$version is not a fork build." ;; esac
[ ! -e "$build/resources/app-update.yml" ] || die "$build has an update feed; refusing to install it."

# Checked before detaching too, so whoever asked hears the refusal.
if [ -n "$(running_app_pids)" ]; then
  [ "$quit" = 1 ] || die "T3 Code is running. Run again with --quit to quit it first."
  check_not_busy "$force"
fi

if [ "$foreground" = 0 ]; then
  detach_self "$(cd "$(dirname "$0")" && pwd)/$(basename "$0")" install "${args[@]+"${args[@]}"}"
  exit 0
fi

log "install of $version started (pid $$)"
if [ "$LAYOUT" = "package" ]; then
  sudo -n true 2>/dev/null || die "install needs passwordless sudo for $FAGNER_APP."
fi

# Keep the exact Nightly that ran on this data, in case pacman updates the package later.
nightly_version="$(app_version "$NIGHTLY_APP")"
if [ -n "$NIGHTLY_KEPT" ] && [ -n "$nightly_version" ] && [ ! -d "$NIGHTLY_KEPT/nightly-$nightly_version" ]; then
  sudo mkdir -p "$NIGHTLY_KEPT"
  sudo cp -a "$NIGHTLY_APP" "$NIGHTLY_KEPT/nightly-$nightly_version.partial"
  sudo mv "$NIGHTLY_KEPT/nightly-$nightly_version.partial" "$NIGHTLY_KEPT/nightly-$nightly_version"
  log "Kept Nightly $nightly_version at $NIGHTLY_KEPT/nightly-$nightly_version"
fi

# Staged before quitting, so T3 is down only for the swap. Beside the package it is root-owned
# like the package, with Chromium's setuid sandbox helper.
as_owner mkdir -p "$(dirname "$FAGNER_APP")"
as_owner rm -rf "$FAGNER_APP.new"
as_owner cp -a "$build" "$FAGNER_APP.new"
if [ "$LAYOUT" = "package" ]; then
  sudo chown -R root:root "$FAGNER_APP.new"
  sudo chmod 4755 "$FAGNER_APP.new/chrome-sandbox"
fi
log "Staged $version at $FAGNER_APP.new"

if [ -n "$(running_app_pids)" ]; then
  [ "$quit" = 1 ] || die "T3 Code is running. Run again with --quit to quit it first."
  check_not_busy "$force"
fi
stop_watchdog
quit_t3_gracefully

if [ -d "$FAGNER_APP" ]; then
  previous="$(app_version "$FAGNER_APP")"
  as_owner rm -rf "$FAGNER_APP_PREVIOUS"
  as_owner mv "$FAGNER_APP" "$FAGNER_APP_PREVIOUS"
  log "Moved the previous fork build $previous to $FAGNER_APP_PREVIOUS"
fi
as_owner mv "$FAGNER_APP.new" "$FAGNER_APP"
log "Installed $FAGNER_APP ($version)"

write_launcher "$FAGNER_APP" "T3 Code (Fagner)"
write_cli_shim "$FAGNER_APP"

if [ "$relaunch" = 1 ]; then
  launch_app "$FAGNER_APP"
fi
start_watchdog "$FAGNER_APP"
log "install finished. Rollback: scripts/fagner/linux rollback --quit"
