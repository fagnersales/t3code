#!/bin/bash
# Make a fork build the T3 this PC opens: put it in /opt/t3code-fagner, point the launcher and the
# t3 CLI at it, relaunch. The pacman Nightly stays installed as the rollback.
#
#   install --quit             quit the running T3 (refuses while a thread is busy), swap, relaunch
#   install                    only if T3 is not running
#   options: --version V (default: the latest build)  --force (quit even with busy threads)
#            --no-relaunch  --foreground (stay attached; used by the detached copy)
#
# Never touches ~/.t3/userdata: the fork adds no migrations, so the Nightly opens the same data.
set -euo pipefail
source "$(dirname "$0")/lib.sh"

quit=0 relaunch=1 foreground=0 force=0 version=""
args=("$@")
while [ $# -gt 0 ]; do
  case "$1" in
    --quit) quit=1 ;;
    --no-relaunch) relaunch=0 ;;
    --foreground) foreground=1 ;;
    --force) force=1 ;;
    --version) version="$2"; shift ;;
    -h | --help) sed -n '2,11p' "$0"; exit 0 ;;
    *) die "Unknown option $1" ;;
  esac
  shift
done

[ -n "$version" ] || version="$(readlink "$FAGNER_LINUX_BUILDS/latest" || true)"
[ -n "$version" ] || die "No build in $FAGNER_LINUX_BUILDS. Run scripts/fagner/linux build first."
build="$FAGNER_LINUX_BUILDS/$version/app"
[ -d "$build" ] || die "No build at $build."
[ "$(app_version "$build")" = "$version" ] || die "$build is version '$(app_version "$build")', not $version."
case "$version" in *-fagner.*) ;; *) die "$version is not a fork build." ;; esac
[ ! -e "$build/resources/app-update.yml" ] || die "$build has an update feed; refusing to install it."

# Checked before detaching too, so whoever asked hears the refusal.
if [ -n "$(running_app_pids)" ]; then
  [ "$quit" = 1 ] || die "T3 Code is running. Run again with --quit to quit it first."
  check_not_busy "$force"
fi

if [ "$foreground" = 0 ]; then
  detach_self "$(cd "$(dirname "$0")" && pwd)/$(basename "$0")" install "${args[@]+"${args[@]}"}"
  exit 0
fi

log "install of $version started (pid $$)"
sudo -n true 2>/dev/null || die "install needs passwordless sudo for $FAGNER_OPT."

# Keep the exact Nightly that ran on this data, in case pacman updates the package later.
nightly_version="$(app_version "$NIGHTLY_OPT")"
if [ -n "$nightly_version" ] && [ ! -d "$FAGNER_OPT_ROLLBACK/nightly-$nightly_version" ]; then
  sudo mkdir -p "$FAGNER_OPT_ROLLBACK"
  sudo cp -a "$NIGHTLY_OPT" "$FAGNER_OPT_ROLLBACK/nightly-$nightly_version.partial"
  sudo mv "$FAGNER_OPT_ROLLBACK/nightly-$nightly_version.partial" "$FAGNER_OPT_ROLLBACK/nightly-$nightly_version"
  log "Kept Nightly $nightly_version at $FAGNER_OPT_ROLLBACK/nightly-$nightly_version"
fi

# Staged before quitting, so T3 is down only for the swap. Root-owned like the package, with
# Chromium's setuid sandbox helper.
sudo rm -rf "$FAGNER_OPT.new"
sudo cp -a "$build" "$FAGNER_OPT.new"
sudo chown -R root:root "$FAGNER_OPT.new"
sudo chmod 4755 "$FAGNER_OPT.new/chrome-sandbox"
log "Staged $version at $FAGNER_OPT.new"

if [ -n "$(running_app_pids)" ]; then
  [ "$quit" = 1 ] || die "T3 Code is running. Run again with --quit to quit it first."
  check_not_busy "$force"
fi
quit_t3_gracefully

if [ -d "$FAGNER_OPT" ]; then
  previous="$(app_version "$FAGNER_OPT")"
  sudo rm -rf "$FAGNER_OPT_PREVIOUS"
  sudo mv "$FAGNER_OPT" "$FAGNER_OPT_PREVIOUS"
  log "Moved the previous fork build $previous to $FAGNER_OPT_PREVIOUS"
fi
sudo mv "$FAGNER_OPT.new" "$FAGNER_OPT"
log "Installed $FAGNER_OPT ($version)"

write_launcher "$FAGNER_OPT" "T3 Code (Fagner)"
write_cli_shim "$FAGNER_OPT"

if [ "$relaunch" = 1 ]; then
  launch_app "$FAGNER_OPT"
fi
log "install finished. Rollback: scripts/fagner/linux rollback --quit"
