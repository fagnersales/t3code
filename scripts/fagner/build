#!/bin/bash
# Build the macOS app and its t3 CLI from this checkout, ready for scripts/fagner/install.
#
#   scripts/fagner/build [--version 0.1.5-nightly.20261029.3877-fagner.2] [--arch arm64]
#
# The version defaults to the one a Linux build of the same app sources got
# (scripts/fagner/linux build), else the Nightly tag this checkout is based on plus the next free
# -fagner.N. Output: $FAGNER_BUILDS_DIR/<version>/T3 Code (Fagner).app, signed with the local
# certificate from scripts/fagner/setup-signing (T3_FAGNER_SIGN_IDENTITY=- for ad-hoc), and the
# `latest` link pointing at it. Builds without an update feed, so the app never updates itself.
set -euo pipefail
source "$(dirname "$0")/lib.sh"

version="" arch="arm64"
while [ $# -gt 0 ]; do
  case "$1" in
    --version) version="$2"; shift ;;
    --arch) arch="$2"; shift ;;
    -h | --help) sed -n '2,10p' "$0"; exit 0 ;;
    *) die "Unknown option $1" ;;
  esac
  shift
done

cd "$FAGNER_REPO_ROOT"
[ -n "$version" ] || version="$(version_for_checkout)"
case "$version" in *-nightly.*-fagner.[0-9]*) ;; *) die "Version '$version' must look like X-nightly.YYYYMMDD.N-fagner.N" ;; esac

out="$FAGNER_BUILDS_DIR/$version"
[ ! -e "$out/$FAGNER_APP_NAME.app" ] || die "$out already has a build of these app sources."
mkdir -p "$out"
record_build_commit "$out"
log "Building $FAGNER_APP_NAME $version ($arch) from $(git rev-parse --short HEAD) into $out"

# T3 Connect works only in builds that carry its public settings.
set -a
source "$FAGNER_REPO_ROOT/scripts/fagner/public-config.env"
set +a
# A repository variable here would make the build embed an update feed.
env -u GITHUB_REPOSITORY -u T3CODE_DESKTOP_UPDATE_REPOSITORY PATH="$FAGNER_REPO_ROOT/node_modules/.bin:$PATH" \
  node scripts/build-desktop-artifact.ts --platform mac --target zip --arch "$arch" \
  --build-version "$version" --output-dir "$out"

zip="$(ls "$out"/*.zip | head -1)"
[ -f "$zip" ] || die "The build produced no zip in $out"
/usr/bin/ditto -x -k "$zip" "$out/unpacked"
built="$(ls -d "$out/unpacked/"*.app | head -1)"
[ "$(basename "$built")" = "$FAGNER_APP_NAME.app" ] || die "Unexpected app name: $built"
mv "$built" "$out/$FAGNER_APP_NAME.app"
rm -rf "$out/unpacked"
app="$out/$FAGNER_APP_NAME.app"

[ "$(plist_version "$app")" = "$version" ] || die "The app reports $(plist_version "$app"), not $version"
[ ! -e "$app/Contents/Resources/app-update.yml" ] || die "The build has an update feed (app-update.yml)"
[ -f "$app/Contents/Resources/app.asar" ] || die "No app.asar in the build"

if [ -n "${T3_FAGNER_SIGN_IDENTITY:-}" ]; then
  identity="$T3_FAGNER_SIGN_IDENTITY"
  /usr/bin/codesign --force --deep --sign "$identity" "$app"
else
  identity="$("$FAGNER_REPO_ROOT/scripts/fagner/setup-signing")"
  /usr/bin/codesign --force --deep --keychain "$SIGNING_KEYCHAIN" --sign "$identity" "$app"
fi
/usr/bin/codesign --verify --deep --strict "$app"
log "Signed with identity '$identity' (- is ad-hoc). macOS knows it as: $(/usr/bin/codesign -dr - "$app" 2>&1 | sed -n 's/^designated => //p')"

ELECTRON_RUN_AS_NODE=1 "$app/Contents/MacOS/$FAGNER_APP_NAME" \
  "$app/Contents/Resources/app.asar/apps/server/dist/bin.mjs" --version
ELECTRON_RUN_AS_NODE=1 "$app/Contents/MacOS/$FAGNER_APP_NAME" \
  "$app/Contents/Resources/app.asar/apps/server/dist/bin.mjs" thread follow --help >/dev/null

ln -sfn "$version" "$FAGNER_BUILDS_DIR/latest"
log "Ready: $app (latest -> $version)"
